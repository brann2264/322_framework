define @main () {





%seconds <- 1

%minutes <- 1

%cmp1 <- 1

%cmp2 <- 1
%seconds <- 1
%minutes <- 1
:begin
call print(%minutes)
call print(%seconds)
%DecodedVar0 <- %minutes >> 1
%DecodedVar1 <- 5 >> 1
%cmp2 <- %DecodedVar0 > %DecodedVar1
%cmp2 <- %cmp2 << 1
%cmp2 <- %cmp2 + 1
%DecodedVar0 <- %cmp2 >> 1
br %DecodedVar0 :end
%DecodedVar0 <- %seconds >> 1
%DecodedVar1 <- 121 >> 1
%cmp1 <- %DecodedVar0 >= %DecodedVar1
%cmp1 <- %cmp1 << 1
%cmp1 <- %cmp1 + 1
%DecodedVar0 <- %cmp1 >> 1
br %DecodedVar0 :tock
%DecodedVar0 <- %seconds >> 1
%DecodedVar1 <- 3 >> 1
%seconds <- %DecodedVar0 + %DecodedVar1
%seconds <- %seconds << 1
%seconds <- %seconds + 1
br :begin
:tock
%DecodedVar0 <- %minutes >> 1
%DecodedVar1 <- 3 >> 1
%minutes <- %DecodedVar0 + %DecodedVar1
%minutes <- %minutes << 1
%minutes <- %minutes + 1
%seconds <- 1
br :begin
:end
return
}
